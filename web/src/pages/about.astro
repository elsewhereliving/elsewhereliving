---
import Base from "../layouts/Base.astro";
import Label from "../components/Label.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
import SectionHead from "../components/SectionHead.astro";
import { getSiteContent } from "../lib/content";
import { optImg, optImgSrcset } from "../lib/img";

const { differentiators, contact } = getSiteContent();
const HERO_IMAGE = "/assets/imagery/c-ocean.jpg";
const waDigits = (contact.whatsappRaw || contact.whatsapp || "").replace(/[^0-9]/g, "");
const waHref = `https://wa.me/${waDigits}`;
const IG_POST = "https://www.instagram.com/p/Den9Mi_D3uM/";
const IG_COVER = "/assets/imagery/sofia-ig-meet-the-agent.jpg";
const stats = [
  { v: "20M+", l: "Views" },
  { v: "40K+", l: "Followers" },
  { v: "6", l: "Markets" },
];
---
<Base
  current="about"
  transparentNav={true}
  title="About | Elsewhere Living"
  description="A boutique agency for the way you actually want to live. We're small on purpose — the only way to give every client the honesty, attention and judgement that buying abroad deserves."
>
  <!-- PageHeader — dark full-bleed hero -->
  <section
    class="ew-grain ew-scrim"
    style="position:relative; overflow:hidden; color:var(--white); background:var(--navy);"
  >
    <img
      src={optImg(HERO_IMAGE, "main")}
      srcset={optImgSrcset(HERO_IMAGE)}
      sizes="100vw"
      fetchpriority="high"
      onerror={`this.onerror=null;this.removeAttribute('srcset');this.src='${HERO_IMAGE}'`}
      alt=""
      style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; opacity:0.55; z-index:0;"
    />
    <div
      style="position:absolute; inset:0; background:linear-gradient(180deg, rgba(15,22,40,0.55), rgba(15,22,40,0.78)); z-index:1;"
    ></div>
    <div
      style="position:relative; z-index:2; max-width:1320px; margin:0 auto; padding:clamp(150px, 18vh, 210px) clamp(20px, 4vw, 56px) clamp(48px, 7vw, 84px);"
    >
      <div class="reveal is-in" style="color:var(--text-on-dark-mut); margin-bottom:20px;">
        <Label>About</Label>
      </div>
      <h1
        class="reveal is-in"
        style="margin:0; max-width:880px; font-family:var(--font-serif); font-weight:300; font-size:clamp(2.4rem, 5.4vw, 4.4rem); line-height:1.02; letter-spacing:-0.02em;"
      >
        A boutique agency for the way you actually want to live.
      </h1>
      <p
        class="reveal is-in"
        style="margin:24px 0 0; max-width:560px; font-family:var(--font-sans); font-weight:300; font-size:17px; line-height:1.7; color:rgba(255,255,255,0.85);"
      >
        Most people buy property. We help you buy possibilities — a slower rhythm of life, a base for
        the family, and an asset that quietly grows while you enjoy it.
      </p>
    </div>
  </section>

  <!-- Founder -->
  <section style="background:var(--paper); padding:clamp(72px, 10vw, 130px) clamp(20px, 4vw, 56px);">
    <div data-grid="split" style="max-width:1320px; margin:0 auto; display:grid; grid-template-columns:1.5fr 1fr; gap:clamp(40px, 6vw, 90px); align-items:center;">
      <div class="reveal">
        <SectionHead
          eyebrow="The person behind it"
          title="Every chapter of my life led here."
          intro="I'm Sofia — Thai, the founder of Elsewhere, and a real estate agent who took the long way here. Before property I was an inventor, an engineer, a fashion blogger, a commercial photographer and a marketer, and I've called seven countries home."
        />
        <p style="margin:18px 0 0; max-width:600px; font-family:var(--font-sans); font-weight:300; font-size:16px; line-height:1.75; color:var(--text-body);">
          Today most of my clients find me through Instagram and TikTok — and suddenly, all those seemingly unrelated chapters make sense. Engineering taught me to solve problems. Marketing taught me to understand people. Living in different countries gave me different perspectives. And my own journey taught me to listen beyond what people say.
        </p>
        <p style="margin:18px 0 0; max-width:600px; font-family:var(--font-sans); font-weight:300; font-size:16px; line-height:1.75; color:var(--text-body);">
          When I lived in Los Angeles, I walked through multimillion-dollar homes and knew I wanted to build them one day. Now I'm working on <a href="/development/" style="color:var(--navy); text-decoration:underline; text-underline-offset:3px;">my first development</a> — more to share soon. Every chapter before this gave me something I use for my clients today.
        </p>
        <div style="margin-top:30px; display:flex; flex-wrap:wrap; gap:12px;">
          <Button href={waHref} variant="solid" size="md" shape="pill" class="ew-cta-navy">WhatsApp</Button>
          <Button href={`mailto:${contact.email}`} variant="outline" size="md" shape="pill">Email</Button>
          <Button href="https://www.instagram.com/sofia.elsewhere/" variant="outline" size="md" shape="pill">Instagram</Button>
        </div>
        <p style="margin:18px 0 0; font-family:var(--font-sans); font-weight:300; font-size:13px; letter-spacing:0.02em; color:var(--slate);">A real person answers — usually within a day.</p>
      </div>
      <div class="reveal" style="display:flex; justify-content:center;">
        <!-- Post card linking to Sofia's "Meet the agent" Instagram post. Instagram's own embed refuses
             this account (embedding is off), so the cover slide is self-hosted and the whole card links out. -->
        <a
          href={IG_POST}
          target="_blank"
          rel="noopener"
          class="ew-ig-card"
          aria-label="Meet the agent — view Sofia's post on Instagram"
          style="display:block; width:100%; max-width:400px; background:var(--white); border:1px solid var(--border-subtle); color:var(--navy); text-decoration:none;"
        >
          <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; padding:12px 14px;">
            <span style="display:inline-flex; align-items:center; gap:9px; font-family:var(--font-sans); font-size:13.5px; font-weight:500;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="1.15" fill="currentColor" stroke="none"/></svg>
              @sofia.elsewhere
            </span>
            <span style="font-family:var(--font-sans); font-size:10.5px; letter-spacing:0.16em; text-transform:uppercase; color:var(--slate);">View post &rarr;</span>
          </div>
          <div style="position:relative; aspect-ratio:4 / 5; overflow:hidden;">
            <img src={optImg(IG_COVER, "main")} srcset={optImgSrcset(IG_COVER)} sizes="(max-width: 720px) 92vw, 400px" loading="lazy" decoding="async" alt="Sofia, founder of Elsewhere — “I'm a real estate agent. But before this, I was…”" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform var(--dur-slow) var(--ease-out);" onerror={`this.onerror=null;this.removeAttribute('srcset');this.src='${IG_COVER}'`} />
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Stats strip -->
  <section style="background:var(--mist); color:var(--navy); padding:clamp(44px, 6vw, 72px) clamp(20px, 4vw, 56px);">
    <div class="reveal" data-grid="3" style="max-width:1100px; margin:0 auto; display:grid; grid-template-columns:repeat(3, 1fr); gap:clamp(20px, 4vw, 52px);">
      {stats.map((s) => (
        <div style="border-top:1px solid rgba(21,38,68,0.2); padding-top:18px;">
          <div style="font-family:var(--font-serif); font-weight:300; font-size:clamp(2rem, 4vw, 3rem); letter-spacing:-0.01em; color:var(--navy); line-height:1;">{s.v}</div>
          <div style="margin-top:10px; font-family:var(--font-sans); font-size:10.5px; letter-spacing:0.18em; text-transform:uppercase; color:var(--navy);">{s.l}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- How we work -->
  <section style="background:var(--navy); color:var(--white); padding:clamp(72px, 10vw, 130px) clamp(20px, 4vw, 56px);">
    <div
      data-grid="split"
      style="max-width:1320px; margin:0 auto; display:grid; grid-template-columns:1.5fr 1fr; gap:clamp(40px, 6vw, 90px); align-items:center;"
    >
      <div class="reveal">
        <SectionHead
          onDark
          eyebrow="How we work"
          title="Small on purpose — and staying that way."
          intro="We're a boutique agency by choice, because we care about quality over quantity. We only work with agents and partners who believe in our vision and mission, so the standard is the same whichever of us you speak with. We believe like attracts like — the clients who find us usually share our values too."
        />
        <p style="margin:18px 0 0; max-width:620px; font-family:var(--font-sans); font-weight:300; font-size:16px; line-height:1.75; color:var(--text-on-dark-mut);">
          Our headquarters is on Koh Samui, Thailand, and we sell across six markets in Thailand, Indonesia and the UAE.
        </p>
      </div>
      <div class="reveal" style="display:flex; justify-content:center;">
        <div class="ew-grain" style="position:relative; width:100%; max-width:380px; aspect-ratio:3 / 4; overflow:hidden;">
          <img
            src={optImg("/assets/imagery/belief-jungle-pool.jpg", "main")}
            srcset={optImgSrcset("/assets/imagery/belief-jungle-pool.jpg")}
            sizes="100vw"
            loading="lazy"
            decoding="async"
            onerror="this.onerror=null;this.removeAttribute('srcset');this.src='/assets/imagery/belief-jungle-pool.jpg'"
            alt=""
            style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- What makes us different -->
  <section style="background:var(--paper); padding:clamp(72px, 10vw, 130px) clamp(20px, 4vw, 56px);">
    <div style="max-width:1320px; margin:0 auto;">
      <div class="reveal" style="margin-bottom:54px;">
        <SectionHead
          eyebrow="What makes us different"
          title="Why owners, buyers and developers choose us."
          max={680}
        />
      </div>
      <div
        class="reveal"
        data-grid="3"
        style="display:grid; grid-template-columns:repeat(3, 1fr); gap:36px clamp(28px, 4vw, 56px);"
      >
        {differentiators.map((d, i) => (
          <div style="border-top:1px solid var(--border-subtle); padding-top:24px;">
            <div style="display:flex; align-items:center; gap:12px;">
              <Icon name={d.i} size={22} color="var(--navy)" stroke={1.4} />
              <span style="font-family:var(--font-sans); font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--slate);">0{i + 1}</span>
            </div>
            <h3 style="margin:16px 0 0; font-family:var(--font-serif); font-weight:300; font-size:clamp(1.4rem, 2.3vw, 1.85rem); line-height:1.12; letter-spacing:-0.01em; color:var(--navy);">{d.t}</h3>
            <p style="margin:12px 0 0; font-family:var(--font-sans); font-weight:300; font-size:15px; line-height:1.72; color:var(--text-body);">{d.b}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTABand -->
  <section class="ew-grain ew-scrim" style="position:relative; overflow:hidden; color:var(--white);">
    <img
      src={optImg("/assets/imagery/cta-journey.jpg", "main")}
      srcset={optImgSrcset("/assets/imagery/cta-journey.jpg")}
      sizes="100vw"
      loading="lazy"
      decoding="async"
      onerror="this.onerror=null;this.removeAttribute('srcset');this.src='/assets/imagery/cta-journey.jpg'"
      alt=""
      style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:0;"
    />
    <div
      style="position:absolute; inset:0; background:linear-gradient(180deg, rgba(10,12,16,0.45), rgba(10,12,16,0.62)); z-index:1;"
    ></div>
    <div
      class="reveal"
      style="position:relative; z-index:2; max-width:880px; margin:0 auto; padding:clamp(80px, 12vw, 170px) clamp(20px, 4vw, 56px); text-align:center;"
    >
      <h2 style="margin:0; font-family:var(--font-serif); font-weight:300; font-size:clamp(2.2rem, 5vw, 4rem); line-height:1.04; letter-spacing:-0.02em;">Start your <span style="font-style:italic;">elsewhere</span> journey.</h2>
      <p style="margin:24px auto 0; max-width:520px; font-family:var(--font-sans); font-weight:300; font-size:17px; line-height:1.7; color:rgba(255,255,255,0.85);">A short, honest conversation — no obligation. Tell us what your elsewhere looks like and we'll take it from there.</p>
      <div style="display:flex; flex-wrap:wrap; gap:14px; justify-content:center; margin-top:38px;">
        <Button href="/contact/" variant="accent" size="lg" shape="pill">Begin the conversation</Button>
        <Button href="/properties/" variant="outline-light" size="lg" shape="pill">See the collection</Button>
      </div>
    </div>
  </section>
  <style>
    .ew-ig-card:hover img { transform: scale(1.03); }
  </style>
</Base>
